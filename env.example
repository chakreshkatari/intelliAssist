# Copy this file to .env and fill in values as needed.
# The app runs fully without any keys set (free local mode).

# --- Optional: LLM generation step ---
# If set, the RAG pipeline will use a real LLM (via LangChain) to generate
# answers instead of the default free local extractive generator.
# Only ONE of these is needed; OpenAI is checked first.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# --- Optional: embedding model override ---
# Any sentence-transformers model name from the Hugging Face Hub.
# Defaults to all-MiniLM-L6-v2 if not set. If the model cannot be
# downloaded (no internet / no HF access), the app automatically falls
# back to a local offline TF-IDF+SVD embedder so it still runs.
EMBEDDING_MODEL=all-MiniLM-L6-v2
